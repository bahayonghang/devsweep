{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devsweep",
  "version": "0.3.0",
  "identifier": "io.github.bahayonghang.devsweep",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DevSweep",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DevSweep contributors",
    "copyright": "Copyright 2026 DevSweep contributors",
    "category": "Utility",
    "shortDescription": "Safety-first developer cleanup for Windows",
    "longDescription": "DevSweep is a local, unsigned five-mode Windows app for Clean, Software, Optimize, Analyze, and Status. Cleanup stays review-first. This package is not signed or published by the five-mode integration task.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
