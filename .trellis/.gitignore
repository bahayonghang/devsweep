# Developer identity (local only)
.developer

# Local hook credentials
hooks.local.json

# Current task pointer (each dev works on different task)
.current-task

# Session/window scoped runtime state
.runtime/

# Ralph Loop state file
.ralph-state.json

# Agent runtime files
.agents/
.agent-log
.session-id

# Task directory runtime files
.plan-log

# Local plan review reports
reviews/

# Atomic update temp files
*.tmp

# Update backup directories
.backup-*

# Conflict resolution temp files
*.new

# Python cache
**/__pycache__/
**/*.pyc

# Large task-evidence artifacts stay local-only (recorded by hash in evidence indexes)
**/evidence/**/axtree/
**/evidence/**/*.json.gz
**/evidence/**/raw-*/
**/evidence/**/raw-latest.txt
