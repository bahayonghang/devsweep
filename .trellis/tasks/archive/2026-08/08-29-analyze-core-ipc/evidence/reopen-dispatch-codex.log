struct DeniedDirectoryGuard {
    path: PathBuf,
    user: String,
}

#[cfg(windows)]
impl DeniedDirectoryGuard {
    fn deny(path: &Path) -> std::io::Result<Self> {
        use std::process::Command;

        let user = std::env::var("USERNAME")
            .map_err(|_| std::io::Error::other("USERNAME missing"))?;
        let output = Command::new("icacls")
            .arg(path)
            .arg("/deny")
            .arg(format!("{user}:(OI)(CI)(R,X)"))
            .output()?;
        if !output.status.success() {
            return Err(std::io::Error::other(format!(
                "icacls deny failed: stdout={} stderr={}",
                String::from_utf8_lossy(&output.stdout),
                String::from_utf8_lossy(&output.stderr)
            )));
        }
        Ok(Self {
            path: path.to_path_buf(),
            user,
        })
    }
}

#[cfg(windows)]
impl Drop for DeniedDirectoryGuard {
    fn drop(&mut self) {
        let _ = std::process::Command::new("icacls")
            .arg(&self.path)
            .arg("/remove:d")
            .arg(&self.user)
            .status();
    }
}
