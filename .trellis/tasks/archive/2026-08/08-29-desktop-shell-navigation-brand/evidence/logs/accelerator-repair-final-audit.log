import json, subprocess
from pathlib import Path
before_raw = subprocess.check_output(["git", "show", "HEAD:resources/i18n/zh-CN.json"])
after_raw = Path("resources/i18n/zh-CN.json").read_bytes()
before = json.loads(before_raw)
after = json.loads(after_raw)
diffs=[]
def walk(a,b,p=""):
    if type(a) is not type(b): diffs.append((p,a,b)); return
    if isinstance(a,dict):
        for k in sorted(set(a)|set(b)):
            q=f"{p}.{k}" if p else k
            if k not in a: diffs.append((q,"<missing>",b[k]))
            elif k not in b: diffs.append((q,a[k],"<missing>"))
            else: walk(a[k],b[k],q)
    elif isinstance(a,list):
        if a != b: diffs.append((p,a,b))
    elif a != b: diffs.append((p,a,b))
walk(before,after)
print(f"semantic_diff_count={len(diffs)}")
for p,a,b in diffs: print(f"semantic_diff={p}: {a!r} -> {b!r}")
print(f"byte_exact_single_replacement={before_raw.replace(b'\"accelerator\": \"Q\"', b'\"accelerator\": null') == after_raw}")
