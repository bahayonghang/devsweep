{
  "forbidden_patterns": [
    "cargo run --locked -p devsweep-cli",
    "target\\debug\\devsweep",
    "target\\release\\devsweep",
    "rm -rf",
    "Remove-Item"
  ],
  "required_terms": [
    "Cleanup Target",
    "Scan Report",
    "Estimated Recoverable",
    "Inspect Only"
  ],
  "fixtures": [
    {
      "path": "evals/fixtures/sample-recommendation.md",
      "expect": "pass",
      "notes": "Inspect-only report uses the global binary and omits execute argv."
    },
    {
      "path": "evals/fixtures/confirmation-list.md",
      "expect": "pass",
      "notes": "Cleanup confirmation list waits; no execute argv."
    },
    {
      "path": "evals/fixtures/bad-execute.md",
      "expect": "fail",
      "notes": "Negative fixture: shell deletion must fail the checker."
    },
    {
      "path": "evals/fixtures/bad-cargo-run.md",
      "expect": "fail",
      "notes": "Negative fixture: cargo run of this repo must fail the checker."
    }
  ]
}
